# FRONTEND
NODE_ENV="development"

NEXT_PUBLIC_FRONT_LOCAL_PORT={PORT}

# Utilisé par le navigateur et le serveur via le proxy Next.js
NEXT_PUBLIC_API_URL={API}

# URL interne pour le proxy Next.js → backend
BACKEND_INTERNAL_URL=http://localhost:{PORT}

# Utilisé par Next.js côté serveur via le réseau Docker
NEXT_PUBLIC_API_SERVER_URL=http://{Nom_conteneur_docker}:{PORT}/api
